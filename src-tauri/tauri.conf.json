{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Idol MV 4K Downloader",
  "version": "1.2.2",
  "identifier": "com.local.idolmv4k",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Idol MV 4K Downloader",
        "width": 1400,
        "height": 860,
        "minWidth": 400,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https://*.ytimg.com https://*.ggpht.com https://www.idol-chart.com https://idol-chart.com https://circlechart.kr https://*.circlechart.kr data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "public.app-category.utilities",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "/Users/ijaegwang/build/yttools/out/": "tools/"
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
